<!-- /snippets/ajax-cart-template.liquid — Mepto native <template> (no Handlebars, saves 46K) -->
{% comment %}
  Native template for ajaxCart (replaces handlebars.min.js). Uses <template> + native JS in src/ajax-cart.js.
  Keep raw / Liquid guards; Handlebars {{#if}}/{{#each}} become plain JS in template clone.
{% endcomment %}
<template id="CartTemplate">
  <form action="/cart" method="post" novalidate class="cart ajaxcart">
    <div class="ajaxcart__inner" data-ajaxcart-items></div>
    <div class="ajaxcart__footer">
      <div class="grid--full">
        <div class="grid__item two-thirds"><p>{{ 'cart.general.subtotal' | t }}</p></div>
        <div class="grid__item one-third text-right"><p data-ajaxcart-totalPrice></p></div>
        <p class="ajaxcart__savings text-center" data-ajaxcart-savings style="display:none"><em></em></p>
      </div>
      <p class="text-center">{{ 'cart.general.shipping_at_checkout' | t }}</p>
      <button type="submit" class="btn--secondary btn--full cart__checkout" name="checkout">{{ 'cart.general.checkout' | t }} &rarr;</button>
      {% if additional_checkout_buttons %}
        <div class="additional_checkout_buttons">{{ content_for_additional_checkout_buttons }}</div>
      {% endif %}
    </div>
    {% if settings.cart_notes_enable %}
      <div><label for="CartSpecialInstructions">{{ 'cart.general.note' | t }}</label><textarea name="note" class="input-full" id="CartSpecialInstructions" data-ajaxcart-note></textarea></div>
    {% endif %}
  </form>
</template>

<template id="AjaxQty">
  <div class="ajaxcart__qty">
    <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--minus icon-fallback-text" data-ajaxcart-qty-minus>
      <span class="icon icon-minus" aria-hidden="true"></span><span class="fallback-text" aria-hidden="true">&minus;</span><span class="visually-hidden">{{ 'cart.general.reduce_quantity' | t }}</span>
    </button>
    <input type="text" class="ajaxcart__qty-num" value="" min="0" data-ajaxcart-qty-num aria-label="quantity" pattern="[0-9]*">
    <button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus icon-fallback-text" data-ajaxcart-qty-plus>
      <span class="icon icon-plus" aria-hidden="true"></span><span class="fallback-text" aria-hidden="true">+</span><span class="visually-hidden">{{ 'cart.general.increase_quantity' | t }}</span>
    </button>
  </div>
</template>

<template id="JsQty">
  <div class="js-qty">
    <button type="button" class="js-qty__adjust js-qty__adjust--minus icon-fallback-text" data-js-qty-minus>
      <span class="icon icon-minus" aria-hidden="true"></span><span class="fallback-text" aria-hidden="true">&minus;</span><span class="visually-hidden">{{ 'cart.general.reduce_quantity' | t }}</span>
    </button>
    <input type="text" class="js-qty__num" value="" min="1" data-js-qty-num aria-label="quantity" pattern="[0-9]*">
    <button type="button" class="js-qty__adjust js-qty__adjust--plus icon-fallback-text" data-js-qty-plus>
      <span class="icon icon-plus" aria-hidden="true"></span><span class="fallback-text" aria-hidden="true">+</span><span class="visually-hidden">{{ 'cart.general.increase_quantity' | t }}</span>
    </button>
  </div>
</template>
