{
  "name": "mimber-mepto",
  "version": "2.2.2-mepto.1",
  "description": "Mimber (Timber 2.2.2) — Mepto-integrated, jQuery-free. First slice: prepareTransition + formatMoney.",
  "type": "module",
  "main": "dist/timber.pkgd.js",
  "module": "dist/timber.esm.js",
  "browserslist": [
    "last 3 versions"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "go run ./cmd/mimber build",
    "build:theme": "node scripts/build-theme.mjs",
    "dev": "vite build --watch",
    "lint": "npx eslint src --ext .js",
    "theme:check": "npx theme check --path dist/theme 2>&1 | head -n 100; echo \"(use shopify theme check for 2.0; ThemeKit theme is 1.0)\"",
    "themekit:build": "go build -o vendor/themekit/bin/theme ./vendor/themekit/...",
    "mimber": "go run ./cmd/mimber --help 2>&1 | head -n 40",
    "mimber:build": "go run ./cmd/mimber build",
    "mimber:deploy": "go run ./cmd/mimber deploy",
    "mimber:preview": "go run ./cmd/mimber preview --url",
    "mimber:harness": "go run ./cmd/mimber harness --preview 2>&1 | tail -n 30",
    "mimber:bin": "go build -o bin/mimber ./cmd/mimber && ls -lh bin/mimber 2>&1 | head -n 5",
    "test": "npx playwright test",
    "test:preview": "npx playwright test --grep preview"
  },
  "peerDependencies": {
    "meptos": ">=2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@shopify/themekit": "^1.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}
